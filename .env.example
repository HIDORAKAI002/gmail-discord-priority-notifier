# MailSync environment template.
# Copy this file to `.env` and replace every placeholder before running production.

# Runtime
NODE_ENV=development
API_PORT=3000
DASHBOARD_PORT=5173
API_BASE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
LANDING_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@MYSQL_HOST:3306/DATABASE
REDIS_URL=redis://127.0.0.1:6379

# Discord OAuth and bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_PUBLIC_KEY=

# Gmail OAuth and optional Gmail Push
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_PUSH_ENABLED=false
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
GMAIL_PUSH_SYNC_INTERVAL_MS=2500
GMAIL_WATCH_RENEWAL_HOURS=24

# Optional AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Security
AUTH_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_64_hex_chars_generated_by_openssl_rand_hex_32
OTP_PEPPER=replace_with_at_least_16_random_characters
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=10
OTP_DELIVERY_MODE=discord

# Email processing
POLLING_INTERVAL_MS=60000
DISCORD_DELIVERY_INTERVAL_MS=5000
MAX_EMAILS_PER_BATCH=50
GMAIL_SYNC_LOOKBACK_MS=900000
GMAIL_MAX_MESSAGES_PER_SYNC=100
DEFAULT_IMPORTANT_THRESHOLD=72
DEFAULT_CRITICAL_THRESHOLD=88

# Optional platform-wide WhatsApp delivery through OpenWA
WHATSAPP_NOTIFICATIONS_ENABLED=false
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=default
